{
  "name": "steam-hour-boost",
  "version": "2.2.7",
  "description": "Increase the hours played in your Steam games.",
  "author": "Luk3Noir",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node -r tsconfig-paths/register --transpiler sucrase/ts-node-plugin src/index.ts",
    "build": "tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "steam",
    "hour",
    "boost",
    "steam-hour-boost"
  ],
  "dependencies": {
    "axios": "^1.8.3",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/steam-totp": "^2.1.2",
    "@types/steam-user": "^5.0.4",
    "sucrase": "^3.35.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "^5.8.2"
  }
}
